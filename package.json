{
  "name": "@glassypic/mcp-server",
  "version": "2.1.2",
  "description": "GlassyPic MCP server transforms raw images into production-ready assets in one workflow: resize, crop, compress, convert file formats, upscale, and generate SEO-friendly filenames and alt text",
  "type": "module",
  "bin": {
    "glassypic-mcp-server": "dist/index.js",
    "mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node scripts/live-test.mjs",
    "test:live:bundle": "node scripts/live-test.mjs --bundle glassypic-$npm_package_version.mcpb",
    "typecheck": "tsc --noEmit",
    "gen:mcpb": "node scripts/gen-mcpb-manifest.mjs",
    "smoke:mcpb": "node scripts/smoke-mcpb.mjs",
    "test:assert-no-skips": "node scripts/assert-no-skipped-tests.mjs",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "image-optimization",
    "image-compression",
    "image-resize",
    "image-upscale",
    "seo",
    "webp",
    "ai-image",
    "claude",
    "glassypic"
  ],
  "mcpName": "io.github.onepunchtechnology/glassypic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onepunchtechnology/glassypic-mcp-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "eventsource": "^3.0.6",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
